{
  "name": "veylora-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented Telegram AI Bot on Cloudflare Workers, D1 and Queues.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "grammy": "1.46.0",
    "fflate": "0.8.2",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.0",
    "@cloudflare/workers-types": "5.20260927.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.141.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
