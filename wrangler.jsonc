{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veylora-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veylora-ai",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_JOBS",
        "queue": "veylora-ai-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "veylora-ai-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "veylora-ai-jobs-dlq",
        "retry_delay": 30
      }
    ]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
